#!/usr/bin/env bash
# dotcat — render a DOT graph sized to the current terminal window and show it inline
# (kitty graphics protocol: kitty, Ghostty, WezTerm).
#
# Usage: dotcat [--dir auto|TB|LR|BT|RL] [--rows N] [--fill] [--theme auto|dark|light]
#               [-K engine] [-o out.png] [file.gv|-]
#   --dir auto  (default) pick TB or LR for this pane (references/orientation.md);
#               a rankdir set in the file wins
#   --rows N    terminal rows to leave free under the image (default 2: prompt + slack)
#   --fill      scale small graphs up to the window (default: never above text size)
#   --theme T   auto (default: re-colour on a dark terminal background), dark, light
#   -K engine   dot (default), neato, fdp, sfdp, circo, twopi; --dir only affects dot
#   -o FILE     keep the PNG. Outside a graphics terminal the PNG is always written
#               (to ./graph.png without -o) and its path printed.
set -euo pipefail

DEFAULT_ROWS=2
DEFAULT_OUT=graph.png
FALLBACK_DPI=96

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=dotfit.sh
. "$here/dotfit.sh"

dir=auto rows=$DEFAULT_ROWS fill= engine=dot out= src=-
while [ $# -gt 0 ]; do
  case $1 in
    --dir) dir=$2; shift 2 ;;
    --rows) rows=$2; shift 2 ;;
    --fill) fill='!'; shift ;;
    --theme) FIT_THEME=$2; shift 2 ;;
    -K) engine=$2; shift 2 ;;
    -o) out=$2; shift 2 ;;
    -h|--help) sed -n '2,/^set /{/^set /d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    *) src=$1; shift ;;
  esac
done

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
cat -- "$src" > "$tmp/in.gv"

if ! fit_gfx; then
  png=${out:-$DEFAULT_OUT}
  "$engine" -Tpng -Gdpi="$FALLBACK_DPI" "$tmp/in.gv" -o "$png"
  echo "$png"
  exit 0
fi

fit_measure "$rows"
fit_colors
fit_layout "$tmp/in.gv" "$tmp/laid.gv" "$dir" "$engine"
png=${out:-$tmp/out.png}
fit_recolor < "$tmp/laid.gv" | neato -n2 -Tpng -Gdpi="$FIT_DPI" -Gsize="$FIT_SIZE$fill" -o "$png"
fit_show < "$png"
