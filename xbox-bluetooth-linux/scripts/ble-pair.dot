// How ble-pair.sh pairs a BLE gamepad. Render: dot -Tpng ble-pair.dot -o ble-pair.png
// ble-pair.sh also renders it while running, highlighting the current step. It
// appends node/edge attributes before the closing brace, so keep "}" as the last
// line, and keep node ids in sync with the script's step() calls. "strict" merges
// a repeated edge statement into the existing edge, which is how the path taken
// gets recoloured.
strict digraph ble_pair {
  graph [rankdir=TB, fontname="Sans", fontsize=10, nodesep=0.25, ranksep=0.28, pad=0.15, bgcolor="#ffffff"]
  node  [shape=box, style="rounded,filled", fontname="Sans", fontsize=10, color="#9e9e9e", fillcolor="#f5f5f5", margin="0.12,0.04"]
  edge  [fontname="Sans", fontsize=9, color="#9e9e9e", fontcolor="#616161", arrowsize=0.6]

  start     [label="Start\nconfig + arguments"]
  service   [label="bluetoothd\nrunning?", shape=diamond]
  adapters  [label="Block --disable adapters\nresolve --adapter address"]
  snapshot  [label="Snapshot devices\npaired · stale unpaired gamepads"]
  session   [label="bluetoothctl session (agent)\npower on · remove MAC + stale"]
  scan      [label="LE scan, up to 3 min\nput the controller in pairing mode"]
  preferred [label="Preferred\nMAC seen?", shape=diamond]
  others    [label="Other gamepads\nfor 5 s?", shape=diamond]
  pair      [label="pair\n(scan stays on)"]
  paired    [label="Pairing\nsuccessful?", shape=diamond]
  connect   [label="trust · connect\nwait for services"]
  verify    [label="Paired and\nconnected?", shape=diamond]
  input     [label="Input device\ncreated?", shape=diamond]
  ok        [label="Done\nexit 0"]
  noinput   [label="No gamepad device · exit 3\nrestart bluetooth"]
  fail      [label="Did not complete\nexit 1"]

  start -> service
  service -> adapters   [label=" yes"]
  service -> fail       [label=" no"]
  adapters -> snapshot
  adapters -> fail      [label=" adapter\n not found"]
  snapshot -> session -> scan -> preferred
  preferred -> pair     [label=" yes"]
  preferred -> others   [label=" no"]
  others -> pair        [label=" exactly one"]
  others -> scan        [label=" none yet", constraint=false, style=dashed]
  others -> fail        [label=" several /\n timeout"]
  pair -> paired
  paired -> connect     [label=" yes"]
  paired -> fail        [label=" no"]
  connect -> verify
  verify -> input       [label=" yes"]
  verify -> fail        [label=" no"]
  input -> ok           [label=" yes"]
  input -> noinput      [label=" no"]
}
