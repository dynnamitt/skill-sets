// How ble-pair.sh pairs a BLE gamepad. Render: dot -Tpng ble-pair.dot -o ble-pair.png
// Steps on the top row, outcomes below: close to a terminal's aspect ratio, so it
// scales up to large text. The script highlights its path by appending attributes
// for these node ids before the closing "}" ("strict" merges the repeated edges).
strict digraph ble_pair {
  graph [fontname="Sans", fontsize=11, labelloc=b, nodesep=0.3, ranksep=0.3, pad=0.1, bgcolor="#ffffff"]
  node  [shape=box, style="rounded,filled", fontname="Sans", fontsize=10, color="#9e9e9e", fillcolor="#f5f5f5", margin="0.1,0.04"]
  edge  [color="#9e9e9e", arrowsize=0.6]

  prep    [label="Prepare\nadapter · agent\nforget stale"]
  scan    [label="Scan ≤ 3 min\npairing mode now"]
  pair    [label="Pair · trust\nconnect"]
  input   [label="Input device?"]
  fail    [label="Failed"]
  ok      [label="Done"]
  noinput [label="No input device\nrestart bluetooth"]

  { rank=same; prep -> scan -> pair -> input }
  { rank=same; fail; ok; noinput }
  prep -> fail; scan -> fail; pair -> fail
  input -> ok; input -> noinput
}
